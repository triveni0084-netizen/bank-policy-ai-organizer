# Backend Configuration
FASTAPI_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database - PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/bank_policy_db
DATABASE_ECHO=True

# Database - MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=bank_policy_documents

# Redis
REDIS_URL=redis://localhost:6379/0

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4

# AWS S3 (Optional)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=bank-policy-documents
AWS_REGION=us-east-1

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@bankpolicy.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_SOCKET_URL=http://localhost:8000

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# JWT
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256

# Application
APP_NAME=Bank Policy AI Organizer
APP_VERSION=2.0.0
SUPPORT_EMAIL=support@bankpolicy.com